// A separate interface preserves the existing SAFEARRAY test interface's ABI.
[
	object,
	uuid(02A02AC1-05CB-4900-B3AE-5263284DECA5),
	oleautomation
]
interface INumericSafearrayTest : IUnknown
{
	HRESULT GetInt8Array([in] short dimensions, [in] long count, [out, retval] SAFEARRAY(char)* result);
	HRESULT GetUint8Array([in] short dimensions, [in] long count, [out, retval] SAFEARRAY(byte)* result);
	HRESULT GetInt16Array([in] short dimensions, [in] long count, [out, retval] SAFEARRAY(short)* result);
	HRESULT GetUint16Array([in] short dimensions, [in] long count, [out, retval] SAFEARRAY(unsigned short)* result);
	HRESULT GetInt32Array([in] short dimensions, [in] long count, [out, retval] SAFEARRAY(long)* result);
	HRESULT GetUint32Array([in] short dimensions, [in] long count, [out, retval] SAFEARRAY(unsigned long)* result);
	HRESULT GetInt64Array([in] short dimensions, [in] long count, [out, retval] SAFEARRAY(hyper)* result);
	HRESULT GetUint64Array([in] short dimensions, [in] long count, [out, retval] SAFEARRAY(unsigned hyper)* result);
	HRESULT GetFloat32Array([in] short dimensions, [in] long count, [out, retval] SAFEARRAY(float)* result);
	HRESULT GetFloat64Array([in] short dimensions, [in] long count, [out, retval] SAFEARRAY(double)* result);
} ;

// A separate interface for scalar input/output and string compatibility.
[
	object,
	uuid(047E34C1-33A8-4DAA-A1E5-B941756A8319),
	oleautomation
]
interface IByteCompatibilityTest : IUnknown
{
	HRESULT EchoInt8([in] small value, [out, retval] small* result);
	HRESULT EchoUint8([in] byte value, [out, retval] byte* result);
	HRESULT EchoLpStr([in] LPSTR value, [out, retval] LPSTR* result);
	HRESULT ReadCharPointer([in] char* value, [out, retval] byte* result);
	// Return one character through a plain char pointer.
	HRESULT GetCharacterBytes([in] byte value, [out, retval] char* result);
} ;

// Interface IDispSafearrayParamTest
[
