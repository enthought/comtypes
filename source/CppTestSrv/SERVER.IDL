dispinterface IDispSafearrayParamTest
{
	interface IDualSafearrayParamTest;
} ;

// Interface IVariantErrorTest
// Regression test double for VT_ERROR VARIANT marshalling (issues #325, #821).
// CreateVariantError constructs the VARIANT entirely in native C++ code:
//   it sets vt = VT_ERROR and scode = errorCode directly without any
//   Python reflection or type-library inference, matching what VBA's CVErr()
//   produces.
// GetErrorCode reads the SCODE back out, matching VBA's CLng() on an error
//   cell, and returns DISP_E_TYPEMISMATCH for any non-VT_ERROR VARIANT.
[
	object,
	uuid(A4421E3A-E17C-496E-B2DF-002C20FEC215),
	oleautomation
]
interface IVariantErrorTest : IUnknown
{
	HRESULT CreateVariantError([in] LONG errorCode, [out, retval] VARIANT* result);
	HRESULT GetErrorCode([in] VARIANT value, [out, retval] LONG* errorCode);
} ;

// Interface IFixedPointNumberTest
// Test interface for converting strings to VT_DECIMAL and VT_CY VARIANTs.
[
	object,
	uuid(8F4E2D1A-7C3B-4A9E-8F1D-2B5C6D7E8F9A),
	oleautomation
]
interface IFixedPointNumberTest : IUnknown
{
	HRESULT ToDecVariant([in] BSTR strValue, [out, retval] VARIANT* result);
	HRESULT ToCyVariant([in] BSTR strValue, [out, retval] VARIANT* result);
	HRESULT DecomposeCyVariant([in] VARIANT value, [out, retval] LONGLONG* result);
	HRESULT DecomposeDecVariant([in] VARIANT value, [out] BYTE* sign, [out] SAFEARRAY(BYTE)* digits, [out] LONG* exponent);
	HRESULT InitCyVariantWith3dot14([in, out] VARIANT* value);
	HRESULT InitDecVariantWith3dot14([in, out] VARIANT* value);
} ;


// Value-only record for basic SAFEARRAY round-trip tests
typedef [uuid(6B298B7B-CA0E-431D-988C-FED3CEB59729)]
struct StructValueRecordSafearrayTest {
    long id;
    long seq;
    hyper checksum;
} StructValueRecordSafearrayTest;


// BSTR-containing record for deep copy validation
typedef [uuid(5F72F918-EC40-42C1-A034-F6608902ECB3)]
struct StructBstrRecordSafearrayTest {
    long id;
    long seq;
    BSTR text;
    hyper checksum;
} StructBstrRecordSafearrayTest;


// IDispatch dual interface for typed record SAFEARRAY
[
    odl,
    uuid(000CB4A0-9492-4E7E-9D1F-E19512B0FA3A),
    dual,
    helpstring("Dual interface for typed record SAFEARRAY round-trip tests."),
    nonextensible,
    oleautomation
]
interface IDualRecordSafearrayTest : IDispatch
{
    // Wrap a single record into a SAFEARRAY of length 1
    [id(1)]
    HRESULT WrapValueRecord(
        [in] StructValueRecordSafearrayTest* record,
        [out, retval] SAFEARRAY(StructValueRecordSafearrayTest)* records
    );

    // Return the first record from a SAFEARRAY
    [id(2)]
    HRESULT FirstValueRecord(
        [in] SAFEARRAY(StructValueRecordSafearrayTest) records,
        [out, retval] StructValueRecordSafearrayTest* record
    );

    // Wrap a single BSTR record into a SAFEARRAY of length 1
    [id(3)]
    HRESULT WrapBstrRecord(
        [in] StructBstrRecordSafearrayTest* record,
        [out, retval] SAFEARRAY(StructBstrRecordSafearrayTest)* records
    );

    // Return the first BSTR record from a SAFEARRAY
    [id(4)]
    HRESULT FirstBstrRecord(
        [in] SAFEARRAY(StructBstrRecordSafearrayTest) records,
        [out, retval] StructBstrRecordSafearrayTest* record
    );
};


// Dispinterface alias for dual interface
[
    uuid(E5D25FDE-3FF5-42A4-BAD0-44BB502D007E),
    helpstring("Dispinterface alias for dual typed record SAFEARRAY tests.")
]
dispinterface IDispRecordSafearrayTest
{
    interface IDualRecordSafearrayTest;
};


