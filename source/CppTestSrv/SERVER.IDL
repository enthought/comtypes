dispinterface IDispRecordSafearrayTest
{
    interface IDualRecordSafearrayTest;
};


// Interface IDualNamedPropertyTest
// Test double for parameterized (named) properties.  A parameterized property
// is a property that takes one or more arguments, e.g. `obj.Item[index]`.
// comtypes exposes such properties through its `named_property` descriptor,
// which supports `obj.Prop[index]`, `obj.Prop[index] = value`,
// `obj.Prop(index)` and tuple indexing `obj.Prop[a, b]`.
//
// The getters return a VARIANT so that reading an index that has not been
// assigned can report DISP_E_BADINDEX through the VARIANT's scode instead of
// inventing a value.  ReadOnlyItem and WriteOnlyItem share the same storage
// as Item, so they only read or only write that single map.
[
	odl,
	uuid(2C7E5B41-9A3D-4F82-B6E1-7D4C8A0F5E93),
	dual,
	helpstring("Dual interface for testing parameterized (named) properties."),
	nonextensible,
	oleautomation
]
interface IDualNamedPropertyTest : IDispatch
{
	// Read/write parameterized property with a single index.
	// Reading an index that has not been assigned returns a VARIANT whose
	// scode is DISP_E_BADINDEX.
	[propget, id(1)]
	HRESULT Item([in] long index, [out, retval] VARIANT* value);
	[propput, id(1)]
	HRESULT Item([in] long index, [in] long value);

	// Read/write parameterized property with two indices that denote a range.
	// Reading Range[start, end] returns a SAFEARRAY(VARIANT) with one element
	// per index in [start, end]; an index that has not been assigned is filled
	// with a VT_NULL VARIANT.  Writing Range[start, end] = values assigns
	// values[i] to index start + i; the number of values must equal
	// end - start + 1.
	[propget, id(2)]
	HRESULT Range([in] long start, [in] long end, [out, retval] VARIANT* value);
	[propput, id(2)]
	HRESULT Range([in] long start, [in] long end, [in] VARIANT value);

	// Read-only parameterized property.  It reads the same map as Item.
	[propget, id(3)]
	HRESULT ReadOnlyItem([in] long index, [out, retval] VARIANT* value);

	// Write-only parameterized property.  It writes the same map as Item.
	[propput, id(4)]
	HRESULT WriteOnlyItem([in] long index, [in] long value);

	// Parameterized property whose only argument is optional.
	// With no index (the all-slice spelling `obj.OptionalItem[:]` or the empty
	// tuple `obj.OptionalItem[()]`), the getter returns the whole map as a
	// sequence of (key, value) pairs and the setter replaces the whole map
	// from such a sequence.  With an index, it behaves like Item.
	[propget, id(5)]
	HRESULT OptionalItem([in, optional] VARIANT index, [out, retval] VARIANT* value);
	[propput, id(5)]
	HRESULT OptionalItem([in, optional] VARIANT index, [in] VARIANT value);

	// Parameterized property that mixes a default-valued argument with an
	// optional argument.  `start` has the default value 1.  When `end` is
	// omitted, the getter reads from `start` to the last assigned index and the
	// setter writes from `start` to the end of the supplied values.  When `end`
	// is given, it behaves like Range.
	[propget, id(6)]
	HRESULT OptionalRange([in, defaultvalue(1)] long start, [in, optional] VARIANT end, [out, retval] VARIANT* value);
	[propput, id(6)]
	HRESULT OptionalRange([in, defaultvalue(1)] long start, [in, optional] VARIANT end, [in] VARIANT value);

	// Parameterized property that combines a required argument, a
	// default-valued argument and an optional argument in one signature.
	// `start` is required, `step` defaults to 1 and `end` is optional.
	// Reading Stride[start, step, end] returns one element per index in the
	// arithmetic sequence start, start+step, ..., <= end; an index that has
	// not been assigned is filled with a VT_NULL VARIANT.  Writing
	// Stride[start, step, end] = values assigns values[i] to index
	// start + i*step; the number of values must equal the number of indices.
	// When `end` is omitted, the getter reads through the last assigned index
	// and the setter writes as many values as were supplied.
	[propget, id(7)]
	HRESULT Stride([in] long start, [in, defaultvalue(1)] long step, [in, optional] VARIANT end, [out, retval] VARIANT* value);
	[propput, id(7)]
	HRESULT Stride([in] long start, [in, defaultvalue(1)] long step, [in, optional] VARIANT end, [in] VARIANT value);
};

// Dispinterface alias for the dual interface.
[
	uuid(6F1A8D24-3B7C-4E59-A0D2-8C5E9B1F4A76),
	helpstring("Dispinterface alias for parameterized (named) property tests.")
]
dispinterface IDispNamedPropertyTest
{
	interface IDualNamedPropertyTest;
};


// Interface IDualPutRefTest
// Test double for a dispinterface code path that parameterized properties do
// not reach:
//   * a propputref property, so comtypes invokes with
//     DISPATCH_PROPERTYPUTREF.
[
	odl,
	uuid(7E4B2C91-5A3D-4F68-9B1E-2C7D4A8F6E35),
	dual,
	helpstring("Dual interface for testing dispinterface propputref code paths."),
	nonextensible,
	oleautomation
]
interface IDualPutRefTest : IDispatch
{
	// propputref property.  The setter must invoke with
	// DISPATCH_PROPERTYPUTREF; the getter reads the stored pointer back.
	// The value is typed as IUnknown (not VARIANT) so that comtypes passes
	// the object reference through as a COM pointer instead of converting it
	// to a VARIANT.
	[propputref, id(2)]
	HRESULT Item([in] long index, [in] IUnknown* value);
	[propget, id(2)]
	HRESULT Item([in] long index, [out, retval] IUnknown** value);
};

// Dispinterface alias for the dual interface.
[
	uuid(8F5C3DA2-6B4E-4A79-8C2F-3D8E5B9A7F46),
	helpstring("Dispinterface alias for dispinterface propputref code path tests.")
]
dispinterface IDispPutRefTest
{
	interface IDualPutRefTest;
};


